# Application
APP_ENV=development
# Optional. Defaults to localhost locally and RENDER_EXTERNAL_URL on Render.
APP_BASE_URL=
DATABASE_URL=postgresql+asyncpg://drone:drone@localhost:5432/drone_assistant
# Optional local cross-origin override. Production is same-origin and disables CORS by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional explicit override. Render's exact external hostname is added automatically.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ADMIN_SECRET=replace-with-a-long-random-secret
RATE_LIMIT_PER_MINUTE=60

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Primary LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# First fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Final fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Provider resilience
LLM_PROVIDER_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_PROVIDER_COOLDOWN_SECONDS=60

# Monitoring and retailer requests
MONITOR_INTERVAL=daily
MONITOR_CONCURRENCY=5
REQUEST_TIMEOUT=12
REQUEST_MAX_RETRIES=1
USER_AGENT=RotorWatch/0.1 (+availability-monitor; contact=you@example.com)
DEMO_MODE=false

# Optional local-only frontend override. Empty means same origin (Vite proxies API paths locally).
VITE_API_BASE_URL=
